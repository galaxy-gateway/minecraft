[Unit]
Description=Minecraft Fabric Server
After=network.target
Wants=network-online.target

[Service]
Type=forking
User=caavere
Group=caavere
WorkingDirectory=/home/caavere/Projects/minecraft

# Start: kill any stale tmux session, then create a new one
ExecStartPre=-/usr/bin/tmux kill-session -t minecraft
ExecStart=/usr/bin/tmux new-session -d -s minecraft /home/caavere/Projects/minecraft/start-fabric.sh

# Stop: send 'stop' command to console for graceful shutdown, then kill tmux session
ExecStop=/usr/bin/tmux send-keys -t minecraft 'stop' Enter
ExecStopPost=-/usr/bin/tmux kill-session -t minecraft

# Timeout for graceful shutdown (world save can take time)
TimeoutStopSec=60

# Restart policy
Restart=on-failure
RestartSec=10

# Process detection
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
