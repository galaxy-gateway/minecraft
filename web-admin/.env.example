# Minecraft Web Admin Configuration

# Bind address (0.0.0.0 for LAN access, 127.0.0.1 for local-only)
BIND_ADDRESS=0.0.0.0:8180

# Admin credentials (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$CHANGE_ME

# Minecraft server directory
MINECRAFT_DIR=/home/caavere/Projects/minecraft

# Session secret (generate a random 64-character hex string)
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING_FOR_PRODUCTION

# Logging level
RUST_LOG=info
